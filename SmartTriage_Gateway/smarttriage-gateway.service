# systemd unit — /etc/systemd/system/smarttriage-gateway.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now smarttriage-gateway
[Unit]
Description=SmartTriage device gateway + demo simulators
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/SmartTriage_v1/SmartTriage_Gateway
Environment=GATEWAY_CONFIG=/etc/smarttriage/devices.yaml
ExecStart=/home/pi/SmartTriage_v1/SmartTriage_Gateway/.venv/bin/uvicorn gateway.app:app --host 0.0.0.0 --port 8090
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
